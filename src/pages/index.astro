---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import profile from "@/assets/images/profile.jpg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import PubList from "@/components/PubList.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { selectedPublications } from "@/data/publications";
import { threads } from "@/data/threads";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const posts = await getCollection("posts");
const recentPosts = getSortedPosts(posts).slice(0, postsConfig.perIndex);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- Hero: name set large beside the portrait, bio and links beneath. -->
    <section id="hero" class="border-border border-b pt-8 pb-8">
      <div
        class="flex gap-8 max-sm:flex-col max-sm:gap-5 sm:items-start"
      >
        {/* The headshot is exactly 3:4, so the box keeps that ratio and
            object-cover crops nothing. It leads the row on desktop and sits
            above the text on phones. */}
        <div class="shrink-0 max-sm:w-28 sm:w-44">
          <Image
            src={profile}
            alt="Ji Young Byun"
            width={352}
            height={470}
            loading="eager"
            class="border-border w-full rounded-md border object-cover object-top max-sm:aspect-square sm:aspect-[3/4]"
          />
        </div>
        <div class="min-w-0 flex-1">
          <h1
            class="font-display text-foreground m-0 text-4xl leading-none font-bold tracking-tight sm:text-5xl"
          >
            Ji Young Byun
          </h1>
          <p
            class="text-accent mt-3 mb-0 font-mono text-xs tracking-widest uppercase"
          >
            Ph.D. Candidate &middot; Johns Hopkins BME
          </p>
          <p class="text-muted-foreground mt-4 mb-0 max-w-prose">
            I develop methods to make <strong class="text-foreground font-semibold"
              >AI systems more capable and reliable</strong
            > for healthcare and scientific discovery. My research spans <strong
              class="text-foreground font-semibold"
              >large language models, vision-language models, and multi-agent
              systems</strong
            >, with a focus on improving biomedical reasoning and rigorously evaluating
            model capabilities and limitations. I&rsquo;m a Ph.D. candidate at Johns
            Hopkins University, advised by Dr. Rama Chellappa, and expect to graduate in
            December 2026.
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
            <Socials />
            <LinkButton
              class="text-accent text-sm"
              href={getRelativeLocaleUrl(locale, "about")}
            >
              More about me &rarr;
            </LinkButton>
          </div>
        </div>

      </div>
    </section>

    <section id="research-threads" class="border-border border-b pt-10 pb-8">
      <h2
        class="text-muted-foreground m-0 font-mono text-xs tracking-widest uppercase"
      >
        What I work on
      </h2>
      <dl class="mt-4 grid grid-cols-2 gap-x-8 gap-y-5 max-sm:grid-cols-1">
        {
          threads.map(thread => (
            <div>
              <dt class="text-foreground text-sm font-semibold">
                {thread.name}
              </dt>
              <dd class="text-muted-foreground mt-1 ms-0 text-sm leading-relaxed">
                {thread.blurb}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="border-border border-b pt-10 pb-6">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-muted-foreground m-0 font-mono text-xs tracking-widest uppercase">
              Recent writing
            </h2>
            <LinkButton
              class="text-accent text-sm"
              href={getRelativeLocaleUrl(locale, "posts")}
            >
              all posts &rarr;
            </LinkButton>
          </div>
          <ul class="mt-2">
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <section id="selected-research" class="pt-10 pb-6">
      <div class="flex items-baseline justify-between gap-4">
        <h2
          class="text-muted-foreground m-0 font-mono text-xs tracking-widest uppercase"
        >
          Selected research
        </h2>
        <LinkButton
          class="text-accent text-sm"
          href={getRelativeLocaleUrl(locale, "publications")}
        >
          All Publications &rarr;
        </LinkButton>
      </div>
      <div class="mt-2">
        <PubList items={selectedPublications} />
      </div>
    </section>

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        All posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
