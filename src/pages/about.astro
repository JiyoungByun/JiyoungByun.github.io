---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { roles, degrees } from "@/data/career";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <main id="main-content" class="app-layout my-1">
    <section class="border-border border-b pt-4 pb-8">
      <h1
        class="font-display text-foreground m-0 text-3xl font-bold tracking-tight sm:text-4xl"
      >
        About
      </h1>
      <div class="app-prose mt-4 max-w-none">
        <Content />
      </div>
    </section>

    <!-- Experience: timeline rail with dots, newest first -->
    <section id="experience" class="border-border border-b pt-10 pb-8">
      <h2
        class="text-muted-foreground m-0 font-mono text-xs tracking-widest uppercase"
      >
        Experience
      </h2>
      <ul class="timeline mt-6">
        {
          roles.map((role, i) => (
            <li class:list={["timeline-item", { current: role.current }]}>
              {/* The two most recent roles open by default; the roles array is
                  ordered by end date, so that is JHU and Merck. */}
              <details open={i < 2}>
                <summary class="timeline-head">
                  <span class="timeline-title">
                    <span class="timeline-role">{role.title}</span>
                    <span class="timeline-sep" aria-hidden="true">
                      ·
                    </span>
                    <span class="timeline-company">{role.org}</span>
                  </span>
                  <span class="timeline-date">{role.dates}</span>
                  <span class="timeline-chevron" aria-hidden="true">
                    &#9656;
                  </span>
                </summary>
                <div class="timeline-body">
                  <p class="timeline-summary">{role.summary}</p>
                  <ul class="timeline-bullets">
                    {role.bullets.map(b => (
                      <li>
                        <span class="bullet-name">{b.name}</span>: {b.detail}
                        {b.venues?.map(v => (
                          <span class="bullet-venue">{v}</span>
                        ))}
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Education: card grid -->
    <section id="education" class="pt-10 pb-8">
      <h2
        class="text-muted-foreground m-0 font-mono text-xs tracking-widest uppercase"
      >
        Education
      </h2>
      <div class="mt-5 grid grid-cols-3 gap-4 max-sm:grid-cols-1">
        {
          degrees.map(d => (
            <div class="border-border bg-card rounded-md border p-4">
              <p class="text-muted-foreground m-0 font-mono text-xs">
                {d.dates}
              </p>
              <h3 class="font-display text-foreground mt-2 mb-0 text-xl font-bold">
                {d.degree}
              </h3>
              <p class="text-foreground mt-1 mb-0 text-sm font-medium">
                {d.field}
              </p>
              <p class="text-accent mt-0.5 mb-0 font-mono text-xs">{d.org}</p>
              {d.advisor && (
                <p class="text-muted-foreground mt-2 mb-0 text-xs leading-relaxed">
                  Advisor: {d.advisor}
                </p>
              )}
              {d.thesis && (
                <p class="text-muted-foreground mt-1 mb-0 text-xs leading-relaxed">
                  Thesis: {d.thesis}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Timeline rail: a 2px line behind the column of dots, inset at both ends so
     it starts and stops level with the first and last dot. */
  .timeline {
    display: grid;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    position: relative;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: 7px;
    width: 2px;
    background: var(--border);
  }

  .timeline-item {
    position: relative;
    padding-left: 2rem;
  }
  /* Hollow ring by default; the page background masks the rail behind it. */
  .timeline-item::before {
    content: "";
    position: absolute;
    top: 0.35rem;
    left: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--background);
    border: 3px solid var(--accent);
  }
  /* The role still running gets a filled dot and a soft halo. */
  .timeline-item.current::before {
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-glow);
  }

  .timeline-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }
  .timeline-head::-webkit-details-marker {
    display: none;
  }
  .timeline-title {
    flex: 1 1 auto;
    min-width: 0;
  }
  .timeline-role {
    font-weight: 600;
    color: var(--foreground);
  }
  .timeline-sep {
    color: var(--muted-foreground);
    margin: 0 0.3rem;
  }
  .timeline-company {
    color: var(--accent);
    font-weight: 600;
  }
  .timeline-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted-foreground);
    white-space: nowrap;
  }
  .timeline-chevron {
    flex-shrink: 0;
    font-size: 1.15rem;
    line-height: 1;
    color: var(--muted-foreground);
    transition:
      transform 0.2s,
      color 0.2s;
  }
  details[open] .timeline-chevron {
    color: var(--accent);
    transform: rotate(90deg);
  }
  .timeline-head:hover .timeline-company {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .timeline-body {
    padding-top: 0.7rem;
    animation: timeline-fade 0.25s ease;
  }
  .timeline-summary {
    margin: 0 0 0.75rem;
    color: var(--foreground);
    font-style: italic;
    font-size: 0.9rem;
  }
  /* Arrow bullets read faster than discs in a dense list. */
  .timeline-bullets {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    color: var(--muted-foreground);
  }
  .timeline-bullets li {
    position: relative;
    padding-left: 1.35rem;
    line-height: 1.6;
  }
  .timeline-bullets li::before {
    content: "\2192";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  /* Project label: the entry point for each line, so it carries the weight. */
  .bullet-name {
    color: var(--foreground);
    font-weight: 600;
  }
  .bullet-venue {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    padding: 1px 0.4rem;
    white-space: nowrap;
    margin-inline-start: 0.45rem;
    vertical-align: 1px;
  }

  @keyframes timeline-fade {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-body {
      animation: none;
    }
    .timeline-chevron {
      transition: none;
    }
  }
</style>
