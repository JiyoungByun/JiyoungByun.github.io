---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { roles, degrees } from "@/data/career";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <main id="main-content" class="app-layout my-1">
    <section class="border-border border-b pt-4 pb-8">
      <h1
        class="font-display text-foreground m-0 text-3xl font-bold tracking-tight sm:text-4xl"
      >
        About
      </h1>
      <div class="app-prose mt-4 max-w-none">
        <Content />
      </div>
    </section>

    <!-- Experience: collapsible rows, newest first -->
    <section id="experience" class="border-border border-b pt-10 pb-8">
      <h2
        class="text-muted-foreground m-0 font-mono text-xs tracking-widest uppercase"
      >
        Experience
      </h2>
      <ul class="mt-5 list-none space-y-1 p-0">
        {
          roles.map((role, i) => (
            <li class="border-border border-b last:border-b-0">
              <details class="group" open={i === 0}>
                <summary class="marker:content-none flex cursor-pointer list-none items-baseline gap-3 py-3 [&::-webkit-details-marker]:hidden">
                  <span
                    class:list={[
                      "mt-1.5 size-2 shrink-0 rounded-full",
                      role.current
                        ? "bg-accent"
                        : "border-muted-foreground border",
                    ]}
                    aria-hidden="true"
                  />
                  <span class="min-w-0 flex-1">
                    <span class="text-foreground font-semibold">
                      {role.title}
                    </span>
                    <span class="text-muted-foreground"> · {role.org}</span>
                  </span>
                  <span class="text-muted-foreground shrink-0 font-mono text-xs whitespace-nowrap max-sm:hidden">
                    {role.dates}
                  </span>
                  <span
                    class="text-muted-foreground shrink-0 transition-transform group-open:rotate-90 motion-reduce:transition-none"
                    aria-hidden="true"
                  >
                    &#9656;
                  </span>
                </summary>
                <div class="ps-5 pb-5">
                  <p class="text-muted-foreground mt-0 mb-1 font-mono text-xs sm:hidden">
                    {role.dates}
                  </p>
                  <p class="text-foreground mt-0 mb-3 text-sm italic">
                    {role.summary}
                  </p>
                  <ul class="text-muted-foreground m-0 list-disc space-y-1.5 ps-4 text-sm">
                    {role.bullets.map(b => (
                      <li class="leading-relaxed">{b}</li>
                    ))}
                  </ul>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {role.tags.map(tag => (
                      <span class="text-muted-foreground border-border rounded border px-1.5 py-px font-mono text-[0.6875rem]">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </details>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Education: card grid -->
    <section id="education" class="pt-10 pb-8">
      <h2
        class="text-muted-foreground m-0 font-mono text-xs tracking-widest uppercase"
      >
        Education
      </h2>
      <div class="mt-5 grid grid-cols-3 gap-4 max-sm:grid-cols-1">
        {
          degrees.map(d => (
            <div class="border-border bg-card rounded-md border p-4">
              <p class="text-muted-foreground m-0 font-mono text-xs">
                {d.dates}
              </p>
              <h3 class="font-display text-foreground mt-2 mb-0 text-xl font-bold">
                {d.degree}
              </h3>
              <p class="text-foreground mt-1 mb-0 text-sm font-medium">
                {d.field}
              </p>
              <p class="text-accent mt-0.5 mb-0 font-mono text-xs">{d.org}</p>
              {d.advisor && (
                <p class="text-muted-foreground mt-2 mb-0 text-xs leading-relaxed">
                  Advisor: {d.advisor}
                </p>
              )}
              {d.thesis && (
                <p class="text-muted-foreground mt-1 mb-0 text-xs leading-relaxed">
                  Thesis: {d.thesis}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
